{
  "format": "hypit.runtime-local@1",
  "dataRoot": ".hypit/runtimes/local",
  "endpoints": {
    "media.local": { "use": "@hypit/provider-media-local" },
    "hyperframes.local": {
      "use": "@hypit/provider-hyperframes-local",
      "config": {
        "chromePath": "/usr/local/bin/chromium-nosandbox",
        "browserGpu": "software",
        "workers": 2,
        "maxWorkers": 4,
        "defaultConcurrency": 1
      }
    }
  }
}
