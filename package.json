{
  "name": "hypit-workbench",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": { "node": ">=22.15.0" },
  "scripts": {
    "dev:server": "pnpm --filter @workbench/server dev",
    "dev:web": "pnpm --filter @workbench/web dev",
    "build": "pnpm --filter @workbench/web build",
    "start": "pnpm --filter @workbench/server start",
    "test": "pnpm --filter @workbench/server test",
    "check": "pnpm --filter @workbench/server exec tsc --noEmit && pnpm --filter @workbench/web exec tsc --noEmit && pnpm --filter '@workbench/provider-*' exec tsc --noEmit",
    "providers:setup": "bash scripts/setup-providers.sh",
    "providers:build": "pnpm --filter '@workbench/provider-*' run build"
  }
}
